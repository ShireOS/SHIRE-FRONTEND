# Supabase (required) - read by apps/web (via vite envDir) and apps/mobile (via app.config.ts)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
API_BASE_URL=
# POS host or /api/v1 base; mobile normalizes either form to /api/v1/dev-v2.
POS_API_BASE_URL=https://shire-pos-api-production.up.railway.app/api/v1/dev-v2

# Vercel / apps/web build-time public config
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional direct API override. Omit to use the same-origin /ml-api proxy.
VITE_API_BASE_URL=
VITE_ML_API_PROXY_TARGET=https://web-production-5c5b4.up.railway.app
VITE_POS_API_PROXY_TARGET=https://shire-pos-api-production.up.railway.app
# Required for complaints and reservation settings in every environment.
VITE_RESERVATIONS_API_BASE_URL=
VITE_PUBLIC_SITE_URL=
VITE_USE_MOCK_DATA=false
VITE_RESTAURANT_ID=
# Optional external overrides for the reseller UI editor. The web app defaults to
# the same-origin Expo exports committed under apps/web/public/previews.
VITE_HOST_UI_PREVIEW_URL=
VITE_POS_UI_PREVIEW_URL=

# The native reseller app can point at those same paths on the frontend deployment.
EXPO_PUBLIC_HOST_UI_PREVIEW_URL=
EXPO_PUBLIC_POS_UI_PREVIEW_URL=

# Used by backend/generate-schema only - Postgres direct connection string
TYPES_LINK=
