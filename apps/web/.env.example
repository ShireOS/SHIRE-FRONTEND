# API Configuration
# Place env files at the repo root (same folder as package.json).
# Copy this file to .env.development or .env.production and fill in values.
# For browser-exposed values, always use the VITE_ prefix.

# Backend API base URL
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Public site origin used for generated guest booking links
VITE_PUBLIC_SITE_URL=https://shireintelligence.com

# Set to 'true' to use mock data instead of real API calls
VITE_USE_MOCK_DATA=false

# Restaurant ID for API calls (get this after seeding data)
VITE_RESTAURANT_ID=default

# ===========================================
# SUPABASE CONFIGURATION
# ===========================================
# Get these from: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# ===========================================
# GOOGLE PLACES API (for address autocomplete)
# ===========================================
VITE_GOOGLE_PLACES_API_KEY=your-google-places-api-key
