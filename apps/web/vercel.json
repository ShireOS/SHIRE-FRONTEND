{
  "framework": "vite",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm --filter web build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/ml-api/(.*)", "destination": "https://web-production-5c5b4.up.railway.app/api/v1/$1" },
    { "source": "/pos-api/(.*)", "destination": "https://shire-pos-api-production.up.railway.app/api/v1/$1" },
    { "source": "/book/(.*)", "destination": "/book/index.html" },
    { "source": "/fake-host-ui/(.*)", "destination": "/index.html" },
    { "source": "/fake-dashboard-demo/(.*)", "destination": "/index.html" },
    { "source": "/host/(.*)", "destination": "/index.html" },
    { "source": "/dashboard/(.*)", "destination": "/index.html" },
    { "source": "/((?!assets/|previews/).*)", "destination": "/index.html" }
  ]
}
